<Dropdown
  @class='custom-dropdown'
  @options={{this.options}}
  @placeholder='Select an option...'
  @value={{this.dropdownValue}}
  @onChange={{fn this.updateField 'dropdownValue'}}
/>

<br />

<HeaderDropdown
  @class='custom-dropdown'
  @options={{this.options}}
  @model={{this}}
  @value={{this.dropdownValue}}
  @onChange={{fn this.updateField 'dropdownValue'}}
/>

<br />

<Radio
  @options={{this.options}}
  @name='radio'
  @label='Radio'
  @value={{this.radioValue}}
  @onChange={{fn this.updateField 'radioValue'}}
/>

<br />

<div style='width: 40%;'>
  <TextInput
    @value={{this.name}}
    @placeholder='Enter text here...'
    @onChange={{fn this.updateField 'name'}}
  />
</div>

<br />

<div style='width: 40%;'>
  <DatePicker @value={{this.date}} @onChange={{fn this.updateField 'date'}} />
</div>

<br />

<Checkbox
  @value={{this.checkboxValue}}
  @onChange={{fn this.updateField 'checkboxValue'}}
  @option={{this.option}}
/>

<br />

<CheckboxGroup
  @options={{this.options}}
  @value={{this.checkboxGroup}}
  @onChange={{fn this.updateGroupField 'checkboxGroup'}}
/>

<br />

<ButtonPrimary @onClick={{this.toggleModal}}>
  Open Modal
</ButtonPrimary>

<br />

<Form
  @class='custom-form'
  @secondaryButtonText='Cancel'
  @model={{this}}
  as |form|
>
  <form.Field
    @label='Form Radio'
    @required={{true}}
    @value={{this.radioValue}}
    @valuePath='radioValue'
    @onChange={{fn this.updateField 'radioValue'}}
    as |field|
  >
    <field.Radio
      @options={{this.options}}
      @name='radio'
      {{!-- @value={{this.radioValue}} --}}
    />
  </form.Field>

  <form.Field
    @label='Form Dropdown'
    @required={{true}}
    @valuePath='dropdownValue'
    @value={{this.dropdownValue}}
    @onChange={{fn this.updateField 'dropdownValue'}}
    as |field|
  >
    <field.Dropdown
      @options={{this.options}}
      @placeholder='Select an option...'
    />
  </form.Field>

  <form.Field
    @label='Form Text Input'
    @required={{true}}
    @valuePath='name'
    @value={{this.name}}
    @onChange={{fn this.updateField 'name'}}
    as |field|
  >
    <field.TextInput @placeholder='Enter text here...' />
  </form.Field>

  <form.Field
    @required={{true}}
    @label='Form Date Picker'
    @valuePath='date'
    @value={{this.date}}
    @onChange={{fn this.updateField 'date'}}
    as |field|
  >
    <field.DatePicker />
  </form.Field>

  <form.Field
    @valuePath='checkboxValue'
    @label='Form Checkbox'
    @required={{true}}
    @value={{this.checkboxValue}}
    @onChange={{fn this.updateField 'checkboxValue'}}
    as |field|
  >
    <field.Checkbox @model={{this}} @option={{this.option}} />
  </form.Field>

  <form.Field
    @label='Form Checkbox Group'
    @valuePath='checkboxGroup'
    @value={{this.checkboxGroup}}
    @required={{true}}
    @onChange={{fn this.updateGroupField 'checkboxGroup'}}
    as |field|
  >
    <field.CheckboxGroup @options={{this.options}} />
  </form.Field>
</Form>

<Modal @toggleModal={{this.toggleModal}} @isOpen={{this.isModalOpen}}>
  <:header>Modal Header</:header>
  <:body>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
  </:body>
</Modal>