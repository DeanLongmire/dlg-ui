<div class='form-field'>
  <div class='label'>
    {{@label}}
    {{#if @required}}<span class='required'>*</span>{{/if}}
  </div>
  <div class='field-input {{if this.error "has-error"}}'>
    {{yield
      (hash
        Checkbox=(component
          'checkbox' class='field-border' value=@value onChange=this.onChange
        )
        CheckboxGroup=(component
          'checkbox-group'
          class='field-border'
          value=@value
          onChange=this.onGroupChange
        )
        DatePicker=(component 'date-picker' value=@value onChange=this.onChange)
        Dropdown=(component 'dropdown' value=@value onChange=this.onChange)
        Radio=(component
          'radio' value=@value class='field-border' onChange=this.onChange
        )
        TextInput=(component 'text-input' value=@value onChange=this.onChange)
      )
    }}
  </div>
  <div class='field-validation'>
    {{this.error}}
  </div>
</div>